# 开发环境仅允许使用 Mock 上游；生产请改用 .env.production，禁止复制此文件直接上线。
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8080
REQUIRE_HTTPS=false
# 上游平台；不是本应用监听端口
UPSTREAM_BASE_URL=http://123.57.8.170:9097
UPSTREAM_AK=MOCKAK2026
UPSTREAM_SECRET=mock-secret-key-2026
UPSTREAM_MOCK=true
UPSTREAM_AUTH_MODE=mock
UPSTREAM_TIMEOUT=20
UPSTREAM_STRICT_TLS=true
# 真实平台请用真实AK/secret；UPSTREAM_MOCK=false,UPSTREAM_AUTH_MODE=sha256
# OpenAI 兼容模型服务。也兼容旧的 DEEPSEEK_BASE_URL/DEEPSEEK_MODEL/DEEPSEEK_API_KEY 变量。
OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1/
MODEL_NAME=deepseek-ai/DeepSeek-V4.1-Flash-1017
OPENAI_API_KEY=
# 图片视觉工具：单张上传最大大小（字节）。图片将发送至配置的视觉模型服务。
VISION_MAX_IMAGE_BYTES=8388608
# Persistent monitoring uses the documented JPEG snapshot endpoint. Interval is configured per monitor.
VIDEO_MONITOR_ENABLED=true
VIDEO_MONITOR_TICK_SECONDS=5
# 必填；python -m app.manage key 生成。长期保持并与数据库分别备份。
FERNET_KEY=
# 统一入口 main:app 本地开发默认 false（http）；https 部署设为 true
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://localhost
REVIEWER_MUST_DIFFER=true
ENFORCE_PASSWORD_POLICY=false
MAX_ITERATIONS=20
DATA_DIR=data
