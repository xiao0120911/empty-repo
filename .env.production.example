# Copy to .env.production on the deployment host. Do not commit the real file.
APP_ENV=production
PUBLIC_BASE_URL=https://regulatory.example.gov.cn
REQUIRE_HTTPS=true
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://regulatory.example.gov.cn
ENFORCE_PASSWORD_POLICY=true

# Real platform only. Mock credentials and HTTP endpoints are rejected at startup.
UPSTREAM_BASE_URL=https://platform.example.gov.cn
UPSTREAM_AK=
UPSTREAM_SECRET=
UPSTREAM_MOCK=false
UPSTREAM_AUTH_MODE=sha256
UPSTREAM_TIMEOUT=20
UPSTREAM_STRICT_TLS=true

# Store only on the deployment host or a secret manager.
FERNET_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL_NAME=
VISION_MAX_IMAGE_BYTES=8388608
VIDEO_MONITOR_ENABLED=true
VIDEO_MONITOR_TICK_SECONDS=5
SESSION_HOURS=8
MAX_ITERATIONS=20
DATA_DIR=/app/data
